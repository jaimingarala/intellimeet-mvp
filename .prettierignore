# Dependencies and build output. Prettier already skips node_modules, but being
# explicit means `--check` can't be surprised by a locally built bundle.
node_modules/
dist/
coverage/

# Lockfiles are generated by npm, which is authoritative for them. Reformatting
# one would churn thousands of lines every time a dependency moves.
package-lock.json

# Documentation is hand-written and hand-aligned. Prettier's table realignment
# would rewrite every table in README.md and NEXT-MILESTONE.md for no gain in
# what a reader can follow.
*.md

# Not source: the assignment brief, local scratch state, and logs.
Zidio Web.pdf
.data/
.freebuff/
*.log
