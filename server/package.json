{
  "name": "intellimeet-server",
  "version": "0.1.0",
  "description": "IntellMeet MVP backend - auth, meetings, WebRTC signaling, chat, AI summaries",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "sweep:guests": "node scripts/sweep-guests.js",
    "test": "node --test --test-force-exit \"test/**/*.test.js\"",
    "test:coverage": "node --test --test-force-exit --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"eslint.config.js\" --test-coverage-lines=85 --test-coverage-functions=85 --test-coverage-branches=70 \"test/**/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.8.3"
  }
}
