# Copy this file to .env and fill in real values

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/intellimeet

# Any long random string
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Port the API + Socket.io server listens on
PORT=5000

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Optional. If unset, the AI summary endpoint falls back to a free,
# offline extractive summarizer instead of calling OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
