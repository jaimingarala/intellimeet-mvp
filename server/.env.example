# Copy this file to .env and fill in real values

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/intellimeet

# Any long random string
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Port the API + Socket.io server listens on
PORT=5000

# Logging. One line per request and one line per failure, in a fixed shape, each
# carrying the id also returned in the X-Request-Id response header.
#   LOG_FORMAT: json (machine-readable) or pretty (default: json in production,
#               pretty everywhere else)
#   LOG_LEVEL:  debug | info | warn | error, or silent to turn the server's own
#               logging off (the test harness sets this)
LOG_LEVEL=info
LOG_FORMAT=

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Optional. If unset, the AI summary endpoint falls back to a free,
# offline extractive summarizer instead of calling OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# "Try the demo" — one click provisions an anonymous guest with a room of their
# own, and lets a visitor join an existing room by opening its link. Guests can
# never be logged into, but the path does create a user per visit, so set
# DEMO_LOGIN_ENABLED=false for a deployment that shouldn't expose it.
DEMO_LOGIN_ENABLED=true
# Title given to the room a guest creates.
DEMO_TITLE=IntellMeet live demo

# How many guest rooms may exist at once. When a new demo room would exceed this,
# the oldest one nobody is in is evicted to make room, so volume stays bounded
# even if the retention sweep isn't running. A room in use is never evicted; if
# every room is occupied the cap is exceeded rather than turning a visitor away.
# Set to 0 to disable the cap.
DEMO_MAX_GUEST_ROOMS=200

# Guests are throwaway, so they are swept: once a guest is older than
# GUEST_RETENTION_HOURS its account and the room it owns are deleted (chat,
# summary and action items along with it) and its seat in any other room is
# released. The sweep runs shortly after boot and then every
# GUEST_RETENTION_INTERVAL_MINUTES. Set GUEST_RETENTION_ENABLED=false to keep
# guests indefinitely. Only accounts flagged as guests are ever touched.
GUEST_RETENTION_ENABLED=true
GUEST_RETENTION_HOURS=24
GUEST_RETENTION_INTERVAL_MINUTES=60

# Confirming the address on a claimed account. A guest may type any email;
# without this, whoever holds the session reserves it — and since email is the
# login key, could later sign in under an address that isn't theirs. So a claim
# emails a one-time link and login is refused until it comes back. Set to false
# only for a deployment that cannot send mail at all: a claim is then trusted
# immediately, as it was before this existed.
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_TTL_HOURS=24

# Where the confirmation link points, i.e. the URL users reach the app at. The
# link is `${APP_BASE_URL}/verify-email?token=…`.
APP_BASE_URL=http://localhost:5173

# How that mail is sent: a POST of { to, subject, text, link } as JSON. Every
# hosted provider offers an HTTP send endpoint, and this keeps the project
# dependency-free. With it unset, dev and test print the mail to the console (and
# keep it in an in-memory outbox) while production sends nothing — a link
# logged in production is a working credential anyone with log access can spend.
MAIL_WEBHOOK_URL=
# Optional bearer token for that webhook.
MAIL_WEBHOOK_TOKEN=

# Operator endpoints: GET /api/admin/stats and POST /api/admin/sweep. Leave this
# empty to switch them off entirely (they 404), which is the default. Set a long
# random value to enable them, then either let the in-process timer run or drive
# the sweep from cron with `npm run sweep:guests`. Sent as the x-admin-token
# header; the sweep runs inside the server so it can see live sessions and won't
# close a demo someone is still in.
ADMIN_TOKEN=
