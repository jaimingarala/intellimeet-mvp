# Copy this file to .env and fill in real values.

# Base URL of the API + Socket.io server.
VITE_API_URL=http://localhost:5000

# Comma-separated STUN servers. Optional; defaults to Google's public STUN.
VITE_STUN_URLS=stun:stun.l.google.com:19302

# Optional TURN relay. Required for calls between peers behind strict or
# symmetric NATs, where a direct P2P path cannot be established. Values are
# served to the browser, so use short-lived credentials for a public server.
# Example:
# VITE_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# VITE_TURN_USERNAME=intellimeet
# VITE_TURN_CREDENTIAL=change_this_turn_password
#
# To test the path without an account, `npm run turn:up` starts a local coturn
# (see turn/ in this repo). Its throwaway credentials are in
# turn/turnserver.conf, and `npm run check:turn` confirms the two agree:
# VITE_TURN_URLS=turn:127.0.0.1:3478
# VITE_TURN_USERNAME=intellimeet
# VITE_TURN_CREDENTIAL=devpassword
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# "relay" restricts ICE to relay candidates, so media can only travel through
# the TURN server above. That turns "the call connected" into "the call
# connected *through TURN*" — the proof run for the cross-network smoke test.
# Leave empty for normal use, where a direct peer-to-peer path is preferable.
# Setting it to relay with no VITE_TURN_URLS means nothing will connect.
VITE_ICE_TRANSPORT_POLICY=
